{
  "name": "drop-watch",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "brand:generate": "pnpm --filter @drop-watch/brand brand:generate",
    "brand:import": "pnpm --filter @drop-watch/brand brand:import",
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:down": "docker compose down postgres",
    "db:generate": "turbo run db:generate -F @drop-watch/db",
    "db:migrate": "turbo run db:migrate -F @drop-watch/db",
    "db:push": "turbo run db:push -F @drop-watch/db",
    "db:seed": "turbo run db:seed -F @drop-watch/db",
    "db:start": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:studio": "turbo run db:studio -F @drop-watch/db",
    "db:verify-user": "turbo run db:verify-user -F @drop-watch/db --",
    "db:watch": "docker compose up postgres",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev -F @drop-watch/web",
    "dev:worker": "turbo run dev -F @drop-watch/worker",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:prod:build": "docker compose -f docker-compose.yml -f docker-compose.prod.yml build",
    "docker:prod:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.yml -f docker-compose.prod.yml logs -f",
    "docker:prod:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "docker:up": "docker compose up -d --build",
    "fix": "ultracite fix",
    "prepare": "husky",
    "test": "turbo run test test:skills",
    "test:e2e": "turbo run test:e2e -F @drop-watch/e2e",
    "test:e2e:ui": "pnpm --filter @drop-watch/e2e test:e2e:ui",
    "test:integration": "turbo run test:integration -F @drop-watch/db",
    "test:skills": "node --test .agents/skills/visual-recap/scripts/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@drop-watch/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "jsdom": "^31.0.0",
    "mermaid": "^12.0.0",
    "minimatch": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.3.1"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "engines": {
    "node": "^26.0.0",
    "pnpm": ">=12"
  }
}
