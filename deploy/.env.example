# DropWatch, prebuilt-image deployment — copy to `.env` next to
# docker-compose.yml and fill in. The variables the applications read are
# validated by a zod schema in `packages/env` and will fail loudly at startup;
# the rest are read by compose itself. See the table in docs/configuration.md
# for which process reads what.

# ---------------------------------------------------------------------------
# Profiles
# ---------------------------------------------------------------------------
# The one line that decides whether Postgres runs in a container. Leave
# `bundled-db` in place and the stack is zero-config: `postgres` starts
# alongside the apps and DATABASE_URL below already points at it. Remove it
# to use Postgres you run elsewhere — you must then set DATABASE_URL
# yourself; nothing in this stack depends on the `postgres` service, so
# dropping the profile switches it off cleanly.
#
# Add `,browser` (i.e. `bundled-db,browser`) to also bring up the
# headless-Chromium `renderer` sidecar for browser-mode listings — see the
# "Browser render mode" section below before enabling it.
COMPOSE_PROFILES=bundled-db

# ---------------------------------------------------------------------------
# Web — the only value you must set
# ---------------------------------------------------------------------------
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# The URL the browser actually uses, and the origin it's allowed to call the
# API from. Defaults are fine on localhost; on a home server or VPS, set both
# to the host's real URL, e.g. http://server.local:3001.
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Password for the bundled `postgres` container. Ignored if you removed
# `bundled-db` from COMPOSE_PROFILES above.
# POSTGRES_PASSWORD=password

# Only needed if you removed `bundled-db` from COMPOSE_PROFILES above — there
# is no sensible default for someone else's database. `host.docker.internal`
# is how the containers reach a Postgres running on the same host.
# DATABASE_URL=postgresql://drop_watch:choose-something-long@host.docker.internal:5432/drop_watch

# Affects scheduling and every timestamp the UI renders. Defaults to
# Europe/London in docker-compose.yml.
# TZ=Europe/London

# ---------------------------------------------------------------------------
# Email (Resend) — all optional
# ---------------------------------------------------------------------------
# `RESEND_API_KEY` is the switch. Leave it unset and you get exactly the
# webhook-only tracker: alerts go to Home Assistant, sign-in demands no
# verification, and the pages that need a mailer (/forgot-password,
# /verify-email, change-email on /account) are not served. That is a fully
# supported configuration, not a degraded one.
#
# Set it and you additionally get email alerts and Better Auth's verification,
# password-reset and change-email flows. Get a key from https://resend.com.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# The `From:` address. Defaults to Resend's shared `onboarding@resend.dev`,
# which needs no verified domain — but Resend will only deliver mail from it to
# the address that owns your Resend account. Fine for a single-user tracker;
# for anything else, verify a domain and set this to an address on it.
# EMAIL_FROM=drop-watch@example.com

# Absolute base URL used for links inside emails. The worker has no
# BETTER_AUTH_URL of its own, so this is the one place both processes agree on
# where the app lives; the web app falls back to BETTER_AUTH_URL.
# APP_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Browser render mode — optional
# ---------------------------------------------------------------------------
# For listings that need JS-composed pages (`render='browser'`, set by SQL —
# see docs/configuration.md). Add `browser` to COMPOSE_PROFILES above to bring
# up the `renderer` sidecar, and set RENDER_URL to point the worker at it.
# Leave both unset and browser-mode listings simply record a `renderer_error`
# check run instead of the worker crashing.
#
# Also download seccomp_profile.json (apps/renderer/seccomp_profile.json in
# the repo) and place it next to docker-compose.yml — it is not baked into
# the image, and the renderer will not start without it.
# RENDER_URL=http://renderer:3002
# Host-enforced browser containment defaults. Increase only after observing
# legitimate renderer pressure; lowering concurrency is usually safer.
# RENDER_CPUS=2.0
# RENDER_MEMORY_LIMIT=2g
# RENDER_PIDS_LIMIT=512
# RENDER_TMPFS_LIMIT=512m

# ---------------------------------------------------------------------------
# Outbound address policy — optional
# ---------------------------------------------------------------------------
# Product pages are fetched only from public IP addresses. Loopback, RFC1918,
# link-local (169.254.169.254, the cloud metadata endpoint) and the rest of
# IANA's non-globally-reachable ranges are refused, on the plain-HTTP path and
# the browser path alike, on the first request and on every redirect after it.
#
# Set this to track something on your own network — a comma-separated list of
# hostnames exempted from that check. Exempt the narrowest name that works: an
# entry here can reach anything that host can.
# ALLOWED_PRIVATE_HOSTS=nas.local,192.168.1.50

# ---------------------------------------------------------------------------
# Image source — optional
# ---------------------------------------------------------------------------
# Where the four images are pulled from. Set DROP_WATCH_IMAGE to point at a
# fork's own namespace instead of editing docker-compose.yml, e.g.
# ghcr.io/yourname/drop-watch. Set DROP_WATCH_VERSION to pin an immutable
# `sha-xxxxxxx` tag instead of tracking `latest`.
# DROP_WATCH_IMAGE=ghcr.io/callumhughes/drop-watch
# DROP_WATCH_VERSION=latest
