# Development config for the Next.js app — copy to `apps/web/.env` and fill in.
#
# This file also feeds every `pnpm db:*` script (migrate, seed, studio,
# verify-user): `packages/db/drizzle.config.ts` and the seed script read it
# explicitly. It does NOT reach the worker — the worker loads its own
# `apps/worker/.env` (see `apps/worker/.env.example`). Deployments use the
# root `.env` instead; see docs/configuration.md.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The compose `postgres` service that `pnpm db:start` brings up:
DATABASE_URL=postgresql://postgres:password@localhost:5432/drop-watch

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# The URL the browser actually uses to reach the app.
BETTER_AUTH_URL=http://localhost:3001
# Normally identical to BETTER_AUTH_URL.
CORS_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# Seed script (`pnpm db:seed`) — creates the single admin account
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@drop-watch.local
SEED_ADMIN_NAME=Admin
# At least 8 characters. No default on purpose: a self-hosted dashboard
# shipping with a known credential is worse than a seed run that fails loudly.
SEED_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Home Assistant — SEED VALUES ONLY
# ---------------------------------------------------------------------------
# These create the singleton `settings` row on first boot and are ignored
# forever after: the row wins, and the settings page owns it from then on.
# Either `web` or the worker may create the row first, so keep these in sync
# with `apps/worker/.env` — or set neither and configure alerting from the
# settings page instead, which is fine.
# HA_URL=http://homeassistant:8123
# HA_WEBHOOK_ID=drop_watch

# ---------------------------------------------------------------------------
# Email (Resend) — optional; nothing works until RESEND_API_KEY is set
# ---------------------------------------------------------------------------
# `RESEND_API_KEY` is the switch. Leave it unset and you get exactly the
# webhook-only tracker: alerts go to Home Assistant, sign-in demands no
# verification, and the pages that need a mailer (/forgot-password,
# /verify-email, change-email on /account) are not served. That is a fully
# supported configuration, not a degraded one.
#
# Set it (get a key from https://resend.com) and you additionally get email
# alerts and Better Auth's verification, password-reset and change-email
# flows. Alert emails are sent by the worker, so set the same email values in
# `apps/worker/.env` too.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# The `From:` address. Defaults to Resend's shared `onboarding@resend.dev`,
# which needs no verified domain — but Resend will only deliver mail from it
# to the address that owns your Resend account. Verify a domain and set this
# to an address on it to escape that.
# EMAIL_FROM=drop-watch@example.com

# Absolute base URL for links inside emails. The web app falls back to
# BETTER_AUTH_URL, so this usually only matters for the worker.
# APP_URL=http://localhost:3001
