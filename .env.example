# DEPLOYMENT (Docker) config — copy to `.env` in the repo root and fill in.
#
# For development use the per-app files instead:
#   apps/web/.env.example    → apps/web/.env    (Next.js app + `pnpm db:*` scripts)
#   apps/worker/.env.example → apps/worker/.env (the worker)
#
# This root file is what compose interpolates and what the containers read.
# Every variable is validated by a zod schema in `packages/env` — see the table
# in docs/configuration.md for which process reads what.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production (`pnpm docker:prod:up`), against the host's Postgres — required,
# there is no default for someone else's database (`host.docker.internal` is
# the host from inside the containers). The local container stack
# (`pnpm docker:up`) sets its own DATABASE_URL; this value is ignored there.
DATABASE_URL=postgresql://drop_watch:choose-something-long@host.docker.internal:5432/drop_watch

# Password for the development-only `postgres` container. Ignored in production.
# POSTGRES_PASSWORD=password

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# The URL the browser actually uses. On a home server, something like
# http://server.local:3001 rather than localhost.
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# Home Assistant — SEED VALUES ONLY
# ---------------------------------------------------------------------------
# These create the singleton `settings` row on first boot and are ignored
# forever after: the row wins, and the settings page owns it from then on.
# Either `web` or `worker` may create it, so set both variables on both
# services or on neither. Leaving them unset is fine — alerting is simply
# unconfigured until you fill in the settings page.
HA_URL=http://homeassistant:8123
HA_WEBHOOK_ID=drop_watch

# ---------------------------------------------------------------------------
# Email (Resend) — all optional
# ---------------------------------------------------------------------------
# `RESEND_API_KEY` is the switch. Leave it unset and you get exactly the
# webhook-only tracker: alerts go to Home Assistant, sign-in demands no
# verification, and the pages that need a mailer (/forgot-password,
# /verify-email, change-email on /account) are not served. That is a fully
# supported configuration, not a degraded one.
#
# Set it and you additionally get email alerts and Better Auth's verification,
# password-reset and change-email flows. Get a key from https://resend.com.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# The `From:` address. Defaults to Resend's shared `onboarding@resend.dev`,
# which needs no verified domain — but Resend will only deliver mail from it to
# the address that owns your Resend account. Fine for a single-user tracker;
# for anything else, verify a domain and set this to an address on it.
# EMAIL_FROM=drop-watch@example.com

# Absolute base URL used for links inside emails. The worker has no
# BETTER_AUTH_URL of its own, so this is the one place both processes agree on
# where the app lives; the web app falls back to BETTER_AUTH_URL.
# APP_URL=http://localhost:3001

# Docker only. The web UI's copy of "is a mailer configured" is inlined into
# the browser bundle at *build* time, and the image is built without
# RESEND_API_KEY — so in a container the flag has to be passed as a build
# argument or the email UI stays hidden however the runtime is configured.
# Compose reads this one for interpolation out of the root `.env` (not
# `apps/web/.env`), and passes it to `apps/web/Dockerfile`. Rebuild after
# changing it: `pnpm docker:prod:up` does. See docs/notifications.md.
# NEXT_PUBLIC_EMAIL_ENABLED=true

# ---------------------------------------------------------------------------
# Browser render mode — optional
# ---------------------------------------------------------------------------
# For listings that need JS-composed pages (`render='browser'`, set by SQL —
# see docs/configuration.md). Two lines turn it on: the profile brings the
# `renderer` sidecar container up, and RENDER_URL points the worker at it.
# Leave both unset and browser-mode listings simply record a `renderer_error`
# check run instead of the worker crashing.
# COMPOSE_PROFILES=browser
# RENDER_URL=http://renderer:3002

# ---------------------------------------------------------------------------
# Outbound address policy — optional
# ---------------------------------------------------------------------------
# Product pages are fetched only from public IP addresses. Loopback, RFC1918,
# link-local (169.254.169.254, the cloud metadata endpoint) and the rest of
# IANA's non-globally-reachable ranges are refused, on the plain-HTTP path and
# the browser path alike, on the first request and on every redirect after it.
#
# Set this to track something on your own network — a comma-separated list of
# hostnames exempted from that check. Exempt the narrowest name that works: an
# entry here can reach anything that host can.
# ALLOWED_PRIVATE_HOSTS=nas.local,192.168.1.50

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Affects scheduling and every timestamp the UI renders. Defaults to
# Europe/London in docker-compose.yml.
# TZ=Europe/London

# Seeding (`pnpm db:seed`, SEED_ADMIN_*) is not configured here: the seed
# script reads `apps/web/.env` — see apps/web/.env.example. To seed a
# production database, point DATABASE_URL there in that file (or the shell).
