# Copy to `.env` (deployment) or `apps/web/.env` (development) and fill in.
# Every variable is validated by a zod schema in `packages/env` — see the table
# in README.md for which process reads what.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development, against the compose `postgres` service:
DATABASE_URL=postgresql://postgres:password@localhost:5432/price-tracker
# Production, against the host's Postgres (docker-compose.prod.yml sets this
# for the containers; `host.docker.internal` is the host from inside them):
# DATABASE_URL=postgresql://price_tracker:choose-something-long@host.docker.internal:5432/price_tracker

# Password for the development-only `postgres` container. Ignored in production.
# POSTGRES_PASSWORD=password

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# The URL the browser actually uses. On a home server, something like
# http://server.local:3001 rather than localhost.
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# Home Assistant — SEED VALUES ONLY
# ---------------------------------------------------------------------------
# These create the singleton `settings` row on first boot and are ignored
# forever after: the row wins, and the settings page owns it from then on.
# Either `web` or `worker` may create it, so set both variables on both
# services or on neither. Leaving them unset is fine — alerting is simply
# unconfigured until you fill in the settings page.
HA_URL=http://homeassistant:8123
HA_WEBHOOK_ID=price_tracker

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Affects scheduling and every timestamp the UI renders. Defaults to
# Europe/London in docker-compose.yml.
# TZ=Europe/London

# ---------------------------------------------------------------------------
# Seed script (`pnpm db:seed`) — creates the single admin account
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@price-tracker.local
SEED_ADMIN_NAME=Admin
# At least 8 characters. No default on purpose: a self-hosted dashboard
# shipping with a known credential is worse than a seed run that fails loudly.
SEED_ADMIN_PASSWORD=change-me
