{
  "name": "@price-tracker/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=../../apps/web/.env src/seed.ts",
    "db:verify-user": "tsx --env-file-if-exists=../../apps/web/.env src/verify-user.ts"
  },
  "dependencies": {
    "@price-tracker/core": "workspace:*",
    "@price-tracker/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@price-tracker/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
