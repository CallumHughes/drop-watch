{
  "name": "@drop-watch/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "vitest run",
    "test:integration:watch": "vitest",
    "db:seed": "tsx --env-file-if-exists=../../apps/web/.env src/seed.ts",
    "db:verify-user": "tsx --env-file-if-exists=../../apps/web/.env src/verify-user.ts"
  },
  "dependencies": {
    "@drop-watch/core": "workspace:*",
    "@drop-watch/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@drop-watch/config": "workspace:*",
    "@types/pg": "catalog:",
    "drizzle-kit": "^0.31.10",
    "rolldown": "^1.2.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
